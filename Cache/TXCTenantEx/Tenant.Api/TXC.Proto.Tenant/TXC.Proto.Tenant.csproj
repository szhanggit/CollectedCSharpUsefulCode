<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net5.0</TargetFramework>
	<RootNamespace>TXC.Proto.Tenant</RootNamespace>
	<PackageId>TXC.Proto.Tenant</PackageId>
	<Version>2.0.0.0</Version>
	<Authors>Edenred</Authors>
	<Description>Tenant Proto</Description>
	<IsPackable>true</IsPackable>
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Protos\common.proto" />
    <None Remove="Protos\tenant_config.proto" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Google.Protobuf" Version="3.21.5" />
	<PackageReference Include="Grpc.AspNetCore" Version="2.47.0" />
	<PackageReference Include="Grpc.Tools" Version="2.48.0">
		<PrivateAssets>all</PrivateAssets>
		<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	</PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\common.proto" AdditionalImportDirs="Protos">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Protobuf>
    <Protobuf Include="Protos\tenant_config.proto" AdditionalImportDirs="Protos">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Protobuf>
  </ItemGroup>
	
</Project>
